<Window x:Class="PrimeDictate.TranscriptionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="500"
        Height="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Border Name="OverlayBorder"
            Padding="0"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource WindowBackgroundBrush}"
            MouseLeftButtonDown="OnBorderMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                <RowDefinition x:Name="ContentRow" Height="*" />
                <RowDefinition x:Name="SpacerRow" Height="12" />
                <RowDefinition x:Name="FooterRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Name="HeaderPanel" Grid.Row="0" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI Emoji" Text="🎙" Foreground="{DynamicResource AccentBrush}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Live transcript" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Focusable="False">
                    <!-- Pin -->
                    <ToggleButton Name="PinButton" Click="OnPinClick" ToolTip="Keep open on screen" AutomationProperties.Name="Keep overlay open" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Padding="4" Margin="0,0,4,0" Focusable="False">
                        <TextBlock Text="📌" FontFamily="Segoe UI Emoji" FontSize="14" />
                    </ToggleButton>
                    <!-- Settings -->
                    <Button Click="OnSettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Padding="4" Margin="0,0,4,0" Focusable="False">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="14" />
                    </Button>
                    <!-- Minimize -->
                    <Button Click="OnMinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Padding="8,4" Margin="0,0,4,0" Focusable="False">
                        <TextBlock Text="—" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" />
                    </Button>
                    <!-- Close -->
                    <Button Click="OnCloseClick" ToolTip="Close" AutomationProperties.Name="Close" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Padding="8,4" Focusable="False">
                        <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Center Content -->
            <Grid Name="ContentPanel" Grid.Row="1" Margin="16,8,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="VisualizationRow" Height="120" />
                    <RowDefinition x:Name="TranscriptRow" Height="*" />
                </Grid.RowDefinitions>

                <!-- Visualization -->
                <Grid Name="VisualizationPanel" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="True" Margin="-16,0,-16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Particle Layer -->
                    <Canvas Name="ParticleCanvas" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" />

                    <!-- Left Waveform (starts in center, flows left) -->
                    <StackPanel Name="LeftWaveform" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,45,0" FlowDirection="RightToLeft" />
                    
                    <!-- Right Waveform (starts in center, flows right) -->
                    <StackPanel Name="RightWaveform" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="45,0,0,0" />
                    
                    <Grid Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Background Glow -->
                        <Ellipse Name="GlowEllipse" Width="250" Height="250" Opacity="0.5" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#40007ACC" Offset="0" />
                                    <GradientStop Color="#00007ACC" Offset="0.8" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Sonar Ring 2 -->
                            <Ellipse Name="Ring2" Width="80" Height="80" Stroke="#007ACC" StrokeThickness="1" Opacity="0">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring2Scale" CenterX="40" CenterY="40" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Sonar Ring 1 -->
                            <Ellipse Name="Ring1" Width="80" Height="80" Stroke="#007ACC" StrokeThickness="2" Opacity="0">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring1Scale" CenterX="40" CenterY="40" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Microphone Background -->
                            <Ellipse Name="PulseCore" Width="80" Height="80" Fill="#FFFFFF" Opacity="0.0" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseCoreScale" CenterX="40" CenterY="40" ScaleX="0.25" ScaleY="0.25" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Mic = fill + separate outline so ripples can sit *under* the border (not a second ring outside it) -->
                            <Ellipse Name="MicFace" Width="80" Height="80" Fill="#1A1F26" />
                            <!-- Bright center glow (voice level): sits on top of dark fill, under outline + emoji -->
                            <Ellipse Name="MicInteriorGlow"
                                     Width="80"
                                     Height="80"
                                     Opacity="0"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.42"
                                                         Center="0.5,0.42"
                                                         RadiusX="0.38"
                                                         RadiusY="0.38">
                                        <GradientStop Color="#F2FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#66FFFFFF" Offset="0.35" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="MicInteriorGlowScale" CenterX="40" CenterY="40" ScaleX="0.82" ScaleY="0.82" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Name="MicOutline"
                                     Width="80"
                                     Height="80"
                                     Fill="Transparent"
                                     Stroke="#007ACC"
                                     StrokeThickness="2" />

                            <!-- Compact ripples: drawn on top of mic fill so they read as inside-out (clipped in code) -->
                            <Ellipse Name="RippleRing0"
                                     Width="80"
                                     Height="80"
                                     Fill="Transparent"
                                     Stroke="#66FFFFFF"
                                     StrokeThickness="1.5"
                                     Opacity="0"
                                     Visibility="Collapsed"
                                     IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RippleRing0Scale" CenterX="40" CenterY="40" ScaleX="0.92" ScaleY="0.92" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Name="RippleRing1"
                                     Width="80"
                                     Height="80"
                                     Fill="Transparent"
                                     Stroke="#59FFFFFF"
                                     StrokeThickness="1.5"
                                     Opacity="0"
                                     Visibility="Collapsed"
                                     IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RippleRing1Scale" CenterX="40" CenterY="40" ScaleX="0.92" ScaleY="0.92" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Name="RippleRing2"
                                     Width="80"
                                     Height="80"
                                     Fill="Transparent"
                                     Stroke="#40FFFFFF"
                                     StrokeThickness="1.5"
                                     Opacity="0"
                                     Visibility="Collapsed"
                                     IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RippleRing2Scale" CenterX="40" CenterY="40" ScaleX="0.92" ScaleY="0.92" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Ellipse Name="PulseSurface"
                                     Width="80"
                                     Height="80"
                                     Opacity="0.0"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush RadiusX="0.65" RadiusY="0.65">
                                        <GradientStop Color="#CFFFFFFF" Offset="0.0" />
                                        <GradientStop Color="#66FFFFFF" Offset="0.35" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseSurfaceScale" CenterX="40" CenterY="40" ScaleX="0.1" ScaleY="0.1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Viewbox Name="MicGlyph"
                                     Width="34"
                                     Height="34"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="0,0,0,4">
                                <Canvas Width="24" Height="24" SnapsToDevicePixels="True">
                                    <Path Name="MicGlyphBody"
                                          Fill="#007ACC"
                                          Data="M12,3 C9.8,3 8,4.8 8,7 L8,12 C8,14.2 9.8,16 12,16 C14.2,16 16,14.2 16,12 L16,7 C16,4.8 14.2,3 12,3 Z" />
                                    <Path Name="MicGlyphSupport"
                                          Stroke="#007ACC"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M6,11 L6,12 C6,15.31 8.69,18 12,18 C15.31,18 18,15.31 18,12 L18,11" />
                                    <Path Name="MicGlyphStem"
                                          Stroke="#007ACC"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M12,18 L12,21 M9,21 L15,21" />
                                </Canvas>
                            </Viewbox>
                            <Border Name="CompactStatusBadge"
                                    Width="18"
                                    Height="18"
                                    Background="#0D1117"
                                    BorderBrush="#2B3440"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,-4,-2"
                                    Visibility="Collapsed">
                                <Ellipse Name="CompactStateDot"
                                         Width="8"
                                         Height="8"
                                         Fill="#20A470"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Transcript Card -->
                <Border Name="TranscriptCard" Grid.Row="1" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="8" Padding="16" MinHeight="100">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,10">
                            <Ellipse Name="StateDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource DangerBrush}" />
                            <TextBlock Name="HeaderText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Listening" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Name="TranscriptText" FontSize="14" LineHeight="20" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Text="Listening..." />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Name="FooterPanel" Grid.Row="3" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Background="{DynamicResource SurfaceElevatedBrush}">
                    <TextBlock Name="LocalOnlyBadgeText"
                               Text="Local only"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               ToolTip="Transcript preview stays on this device. Audio is not uploaded." />
                </Border>

                <TextBlock Name="TimerText"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="00:00"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           FontFamily="Consolas"
                           ToolTip="Elapsed dictation time" />

                <Button Name="CopyTranscriptButton"
                        Grid.Column="2"
                        Click="OnCopyClick"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="8,4"
                        Focusable="False"
                        IsEnabled="False"
                        ToolTip="Copy the current transcript preview"
                        AutomationProperties.Name="Copy transcript">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontFamily="Segoe UI Emoji" Margin="0,0,6,0" FontSize="12" />
                        <TextBlock Text="Copy" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
