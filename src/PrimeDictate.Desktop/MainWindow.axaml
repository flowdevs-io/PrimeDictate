<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimeDictate.Desktop.MainWindow"
        Title="PrimeDictate" Width="900" Height="600">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="PrimeDictate" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="PlatformText" Opacity="0.7" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <TabControl Margin="12">
      <TabItem Header="Transcription">
        <StackPanel Spacing="12" Margin="8">
          <TextBlock TextWrapping="Wrap"
                     Text="Import a recording or record from a microphone. Transcription never types into other apps or runs voice commands." />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Microphone recording captures your voice only. It does not capture other people on a call." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open file…" IsEnabled="False" />
            <Button Content="Record" IsEnabled="False" />
          </StackPanel>
          <TextBlock x:Name="AudioStatus" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Dictation">
        <TextBlock Margin="8" TextWrapping="Wrap" x:Name="DictationStatus" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
